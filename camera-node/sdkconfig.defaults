# XIAO ESP32-S3 Sense: 8 MB flash, 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Boot time matters (the node boots cold on every trigger): no PSRAM memory test.
CONFIG_SPIRAM_MEMTEST=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# UART0 (D6/D7) carries the EW,... lines to the trigger board, so the console and debug log go to USB.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The person model lives in its own flash partition; PlatformIO cannot run the component's embed step.
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_PARTITION=y
